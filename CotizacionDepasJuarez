<script>
  const pkgs = document.querySelectorAll('.pkg');
  const chosenText = document.getElementById('chosen-text');
  const copyBtn = document.getElementById('copy-btn');
  const waBtn = document.getElementById('wa-btn');

  let selected = null;

  pkgs.forEach(pkg => {
    const btn = pkg.querySelector('.select-btn');
    btn.addEventListener('click', () => {
      pkgs.forEach(p => { p.classList.remove('active'); p.querySelector('.select-btn').textContent = 'Seleccionar paquete'; });
      pkg.classList.add('active');
      btn.textContent = 'Paquete seleccionado';

      selected = { name: pkg.dataset.name, price: pkg.dataset.price };
      chosenText.innerHTML = selected.name + ' — <span class="amount">$' + selected.price + ' MXN</span>';

      copyBtn.classList.remove('disabled');
      waBtn.classList.remove('disabled');

      const msg = 'Hola, me interesa el paquete ' + selected.name + ' de contenido para mis departamentos: $' + selected.price + ' MXN. ¿Me confirmas los siguientes pasos?';
      // URL de WhatsApp actualizada
      waBtn.href = 'https://wa.me/18714685974?text=' + encodeURIComponent(msg);
    });
  });

  copyBtn.addEventListener('click', () => {
    if (!selected) return;
    const msg = 'Paquete ' + selected.name + ' — $' + selected.price + ' MXN (GEA Films)';
    navigator.clipboard.writeText(msg).then(() => {
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copiado ✓';
      setTimeout(() => { copyBtn.textContent = original; }, 1800);
    });
  });
</script>

